<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.tatsuya.orbisextract</ApplicationId>
    <ApplicationTitle>OrbisExtract</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.5</ApplicationDisplayVersion>
    <ApplicationVersion>1050000</ApplicationVersion>
    <Version>1.0.5</Version>
    <AndroidPackageFormats Condition="'$(AndroidPackageFormats)' == ''">apk</AndroidPackageFormats>
    <DistributionChannel Condition="'$(DistributionChannel)' == ''">Github</DistributionChannel>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DistributionChannel)' == 'Play'">
    <DefineConstants>$(DefineConstants);PLAY_STORE</DefineConstants>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <Target Name="ValidateDistribution" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DistributionChannel)' != 'Play' and '$(DistributionChannel)' != 'Github'" Text="DistributionChannel must be Play or Github." />
    <Error Condition="'$(AndroidPackageFormats)' == 'aab' and '$(DistributionChannel)' != 'Play'" Text="Build store bundles with DistributionChannel=Play." />
  </Target>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../LICENSE" LogicalName="OrbisExtract.LICENSE" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OrbisExtract.App\App.axaml.cs" Link="App.axaml.cs" />
    <Compile Include="..\OrbisExtract.App\AppNotificationHelper.cs" Link="AppNotificationHelper.cs" />
    <Compile Include="..\OrbisExtract.App\AppLicense.cs" Link="AppLicense.cs" />
    <Compile Include="..\OrbisExtract.App\ExtractionHistory.cs" Link="ExtractionHistory.cs" />
    <Compile Include="..\OrbisExtract.App\ViewModels\**\*.cs" Link="ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\OrbisExtract.App\Views\**\*.cs" Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\OrbisExtract.App\Updates\**\*.cs" Link="Updates\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\OrbisExtract.App\Localization\**\*.cs" Link="Localization\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(MSBuildProjectDirectory)/../OrbisExtract.App/App.axaml" Link="App.axaml" />
    <AvaloniaResource Include="$(MSBuildProjectDirectory)/../OrbisExtract.App/Views/**/*.axaml" Link="Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(MSBuildProjectDirectory)/../OrbisExtract.App/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\OrbisExtract.Core\OrbisExtract.Core.csproj" />
    <ProjectReference Include="..\..\OrbisExtract.Infrastructure.OpenOrbis\OrbisExtract.Infrastructure.OpenOrbis.csproj" />
  </ItemGroup>
</Project>
