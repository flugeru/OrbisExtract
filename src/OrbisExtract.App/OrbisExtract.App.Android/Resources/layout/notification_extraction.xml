<?xml version="1.0" encoding="utf-8"?>
<!-- Compact, theme-independent RemoteViews for MIUI/HyperOS Classic (API 24+).
     Never resolve text colors from the app theme: SystemUI may inflate them
     against the app's light theme while painting a dark notification surface. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/extraction_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">
    <TextView
        android:id="@+id/extraction_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center_vertical"/>
    <ProgressBar
        android:id="@+id/extraction_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progressTint="#FF85B3FF"
        android:progressBackgroundTint="#FF52545B"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/extraction_detail"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFCED0D6"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/extraction_pause"
            android:background="@drawable/notification_pause_bg"
            android:layout_width="wrap_content"
            android:minWidth="66dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:textColor="#FFB8D2FF"
            android:textSize="12sp"
            android:clickable="true"/>
        <TextView
            android:id="@+id/extraction_cancel"
            android:background="@drawable/notification_cancel_bg"
            android:layout_width="wrap_content"
            android:minWidth="66dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFC2C2"
            android:textSize="12sp"
            android:clickable="true"/>
    </LinearLayout>
</LinearLayout>
